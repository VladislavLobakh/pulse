---
title: "Research workflow core (current / Implemented)"
---
flowchart TD
    cli(["pulse.main CLI"]) --> start([PulseInput · query])
    start --> init["initialize_state<br/>strip query"]
    init -- "empty / whitespace" --> err(["raise InvalidQueryError<br/>(before coordinator)"])
    err --> exitInput["CLI: catch InvalidQueryError<br/>exit 2 · no traceback"]
    init -- "non-empty" --> collect["collect_sources<br/>await coordinator(query) · once"]
    collect --> coord[["patterns.parallel run_sources<br/>(gather · isolation · dedup · aggregate)"]]
    coord --> route{"route_by_status<br/>parallel_result.status"}
    route -- "success / partial" --> analyze["analyze_items<br/>await analyzer(query, items) · once<br/>AnalysisRunResult.completed / .aborted"]
    route -- "failed" --> failNode["finalize_failure<br/>AnalysisRunResult.skipped() · analyzer never called"]
    analyze --> okNode["finalize_results<br/>pass result + analysis through"]
    okNode --> done([PulseOutput · result + analysis])
    failNode --> done
    done --> dispCheck{"CLI: result.status"}
    dispCheck -- "success / partial" --> exitOk["print_run_summary + print_items + print_analysis_summary<br/>exit 0, or exit 1 if analysis FAILED"]
    dispCheck -- "failed" --> exitFail["print_run_summary only<br/>exit 1"]

    note["acyclic graph — no recursion_limit;<br/>this is the production CLI path (see ADR 16, ADR 18)"]
    collect -.-> note
