---
title: "Parallel source collect flow (current / Implemented)"
---
sequenceDiagram
    actor User
    participant CLI as CLI (pulse.main)
    participant Par as patterns.parallel run_sources (coordinator)
    participant Run as Configured source runners × N (worker threads)
    participant HN as agents.hn hn_runner
    participant React as patterns.react (ReAct engine)
    participant AX as agents.arxiv arxiv_runner
    participant AXCol as collectors.arxiv
    participant AXAPI as ArXiv Atom API
    participant Extract as Tavily Extract
    participant YT as agents.youtube youtube_runner
    participant YTCol as collectors.youtube
    participant TavS as Tavily Search
    participant YTAPI as YouTube transcript endpoint
    participant NL as agents.newsletter newsletter_runner
    participant NLCol as collectors.newsletter
    participant Feeds as Newsletter RSS/Atom feeds
    participant Disp as display

    User->>CLI: uv run python -m pulse.main "query"
    CLI->>Par: run_sources(query, build_runners())
    Par->>Par: empty runners -> ValueError (configuration error)

    par asyncio.gather — one asyncio.to_thread task per runner
        Par->>Run: asyncio.to_thread(runner.run, query)
        alt configured runner is Hacker News
            Run->>HN: _run_for_parallel(query, max_results)
            HN->>React: run_hn_react(query, max_results)
            React-->>HN: ReActResult(items, stop_reason)
            HN-->>Run: SourceOutput from stop_reason + min(MIN_ARTICLES, max_results)
        else configured runner is ArXiv
            Run->>AX: _run_for_parallel(original_query, limits)
            AX->>AXCol: search_arxiv_papers(original_query, limits)
            AXCol->>AXCol: deterministically build fielded ArXiv query
            AXCol->>AXCol: serialize; wait ≥3 s from previous request start
            AXCol->>AXAPI: one bounded GET (30 s timeout)
            AXAPI-->>AXCol: Atom feed
            AXCol->>AXCol: reject error feed; skip malformed papers; normalize SourceItems
            opt first 0–2 papers with PDF links
                AXCol->>Extract: one query-focused batch (20 s timeout)
                Extract-->>AXCol: raw_content per successful URL
                AXCol->>AXCol: append bounded highlights; failures keep abstracts
            end
            AXCol-->>AX: SourceItemList
            AX-->>Run: SUCCESS or PARTIAL(no_results)
        else configured runner is YouTube
            Run->>YT: _run_for_parallel(query, limits)
            YT->>YTCol: search_youtube_videos(query, limits)
            YTCol->>TavS: search restricted to youtube.com
            TavS-->>YTCol: discovered video URLs
            YTCol->>YTCol: normalize URL variants to canonical video ids; dedup
            loop first ≤ MAX_TRANSCRIPTS candidates (one shared session, finite timeout)
                YTCol->>YTAPI: fetch transcript
                alt captions disabled / missing / restricted
                    YTCol->>YTCol: record skip (video id + exception class name only)
                else transcript available
                    YTCol->>YTCol: bounded whitespace-normalized excerpt -> SourceItem
                end
            end
            Note over YTCol: request blocks, unparsable data and unknown errors propagate
            YTCol-->>YT: YouTubeCollectResult(items, skipped)
            YT-->>Run: SUCCESS or PARTIAL(skipped_videos | no_transcripts | no_results)
        else configured runner is Newsletter
            Run->>NL: _run_for_parallel(query, max_results)
            NL->>NLCol: fetch_newsletter_items(query, max_results)
            loop each configured feed (Latent Space, Simon Willison)
                NLCol->>Feeds: one bounded GET (10 s timeout)
                Feeds-->>NLCol: RSS/Atom bytes
                NLCol->>NLCol: feed failure -> warn + continue; skip malformed entries
            end
            NLCol->>NLCol: deterministic keyword scoring; drop zero scores; dedup canonical URLs
            Note over NLCol: every feed failing raises NewsletterFeedError
            NLCol-->>NL: NewsletterFetchResult(items, failed_feeds)
            NL-->>Run: SUCCESS or PARTIAL(no_results | partial_feed_failure)
        end
        alt runner raises
            Run-->>Par: FAILED SourceRunResult (error = exception class name; safe log, no message)
        else runner returns SourceOutput
            Run-->>Par: SourceRunResult keeps runner status/error, adds source + elapsed_ms
        end
    end

    Par->>Par: combine non-FAILED items, dedup normalized URLs (first in runner order wins)
    Par->>Par: aggregate status: all success / all failed / else partial
    Par-->>CLI: ParallelRunResult(results, items, status, elapsed_ms)
    CLI->>Disp: print_run_summary(result) (per-source status/count/elapsed + aggregate line)
    alt aggregate status is FAILED
        CLI-->>User: source summary only, exit code 1, no item listing
    else aggregate status is SUCCESS or PARTIAL
        CLI->>Disp: print_items(result.items)
        Disp-->>User: source summary + N combined items (title, url, score, summary)
    end
